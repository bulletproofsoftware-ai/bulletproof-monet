{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@MONET_HOME@/.claude/scripts/prompt-memory-recall.sh",
            "timeout": 15000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "@MONET_HOME@/.claude/scripts/memory-first-gate.sh",
            "timeout": 8000
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "@MONET_HOME@/.claude/scripts/memory-first-gate.sh",
            "timeout": 8000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@MONET_HOME@/.claude/scripts/session-nudge.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "@MONET_HOME@/.claude/scripts/skill-usage-hook.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true
}