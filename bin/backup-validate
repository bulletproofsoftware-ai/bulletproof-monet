#!/usr/bin/env python3
"""backup-validate — validate the n8n workflow backup export (PRD #40).

Silent corruption is the enemy: a backup file can exist but be empty,
truncated, invalid JSON, or missing workflows — and you only discover it when a
restore fails. This checks the newest workflows-*.json export for:
  - present and non-empty
  - valid JSON
  - a list of workflows (n8n `export:workflow --all` shape)
  - at least MIN_WORKFLOWS entries
  - every workflow has nodes (i.e. actually restorable)

Exit 0 + summary on success (logged, quiet). Exit 1 + LOUD Telegram alert on
failure. Runs root-side (backups are root-owned); hooked into
/root/backup-services.sh after the n8n export.

  backup-validate [backup_dir]     default /root/backups/n8n
"""
import glob
import json
import os
import subprocess
import sys
import time
import os as _os, sys as _sys
_sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "..", "lib"))
import monet_paths

HOME = monet_paths.MONET_HOME
BACKUP_DIR = sys.argv[1] if len(sys.argv) > 1 else "/root/backups/n8n"
MIN_WORKFLOWS = int(os.environ.get("BACKUP_MIN_WORKFLOWS", "1"))
MAX_AGE_H = float(os.environ.get("BACKUP_MAX_AGE_H", "30"))  # newest export should be recent


def newest():
    files = sorted(glob.glob(os.path.join(BACKUP_DIR, "workflows-*.json")))
    return files[-1] if files else None


def validate():
    f = newest()
    if not f:
        return False, f"no workflows-*.json found in {BACKUP_DIR}"
    base = os.path.basename(f)
    size = os.path.getsize(f)
    if size == 0:
        return False, f"{base} is EMPTY (0 bytes)"
    age_h = (time.time() - os.path.getmtime(f)) / 3600
    if age_h > MAX_AGE_H:
        return False, f"{base} is STALE ({age_h:.1f}h old; backup may not be running)"
    try:
        with open(f) as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError) as e:
        return False, f"{base} is not valid JSON: {e}"
    wfs = data if isinstance(data, list) else (data.get("data") if isinstance(data, dict) else None)
    if not isinstance(wfs, list):
        return False, f"{base} has unexpected structure (not a workflow list)"
    if len(wfs) < MIN_WORKFLOWS:
        return False, f"{base} has only {len(wfs)} workflows (expected >= {MIN_WORKFLOWS})"
    missing = [w.get("name", "?") for w in wfs
               if not isinstance(w, dict) or not w.get("nodes")]
    if missing:
        return False, f"{base}: {len(missing)} workflow(s) missing nodes: {', '.join(missing[:5])}"
    return True, f"{base}: {len(wfs)} workflows, {size} bytes, valid JSON, all have nodes ({age_h:.1f}h old)"


def alert_tg(text):
    chat = os.environ.get("MONET_DEFAULT_CHAT", "")
    if not chat:
        chat = os.environ.get("MONET_CHAT_ID", "")
    if not chat:
        return
    try:
        subprocess.run([f"{HOME}/tg-send.sh", chat], input=text, text=True, timeout=30)
    except Exception:  # noqa: BLE001
        pass


def main():
    ok, msg = validate()
    if ok:
        print("✅ n8n backup valid — " + msg)
        sys.exit(0)
    alert = "🚨 n8n BACKUP VALIDATION FAILED — " + msg
    print(alert)
    alert_tg(alert)
    sys.exit(1)


if __name__ == "__main__":
    main()
