#!/usr/bin/env python3
"""research-queue — overnight research queue for Monet (PRD #16).

Subcommands:
  add <chat_id> <query>   queue a question for the overnight batch
  list                    show pending questions
  drain                   print pending as TSV (chat_id<TAB>query) and clear

Storage: $MONET_HOME/research-queue.json (atomic writes). The 03:00 cron
(monet-research-overnight.sh) drains this and runs monet-research.sh per item.
"""
import json
import os
import sys
import tempfile
import time
import os as _os, sys as _sys
_sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "..", "lib"))
import monet_paths

QUEUE = os.environ.get("MONET_RESEARCH_QUEUE", monet_paths.path("research-queue.json"))


def load():
    try:
        with open(QUEUE) as fh:
            data = json.load(fh)
            return data if isinstance(data, list) else []
    except (OSError, json.JSONDecodeError):
        return []


def save(items):
    d = os.path.dirname(QUEUE) or "."
    fd, tmp = tempfile.mkstemp(dir=d)
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(items, fh, indent=2)
        os.replace(tmp, QUEUE)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
    if cmd == "add":
        if len(sys.argv) < 4:
            print("usage: research-queue add <chat_id> <query>")
            return
        chat, query = sys.argv[2], " ".join(sys.argv[3:]).strip()
        if not query:
            print("usage: research-queue add <chat_id> <query>")
            return
        items = load()
        items.append({"chat_id": chat, "query": query, "queued_at": int(time.time())})
        save(items)
        print(f"queued ({len(items)} pending)")
    elif cmd == "list":
        items = load()
        if not items:
            print("(empty)")
            return
        for i, it in enumerate(items, 1):
            print(f"{i}. [{it.get('chat_id','')}] {it.get('query','')}")
    elif cmd == "drain":
        items = load()
        save([])
        for it in items:
            chat = str(it.get("chat_id", "")).replace("\t", " ")
            query = str(it.get("query", "")).replace("\t", " ").replace("\n", " ")
            if chat and query:
                print(f"{chat}\t{query}")
    else:
        print("usage: research-queue add <chat_id> <query> | list | drain")


if __name__ == "__main__":
    main()
