#!/bin/bash
# monet-meeting-prep — 30-min-before meeting prep briefs (PRD #36).
# Cron every 5 min, flock-guarded. Polls Google Calendar for events starting in
# ~30 min, and for each not-yet-briefed event runs a prep prompt through Claude
# (research attendees + pull memory) and delivers a 3-point brief to Telegram.
# Mirrors monet-cron.sh's prompt->Claude->tg-send delivery path.
# Pin cwd+HOME: `claude` derives its projects/<slug> dir from the working
# directory. Without this, sessions are written under one slug dir and
# resumed under another -> "No conversation found" on a live transcript.

# shellcheck source=lib/monet-env.sh
. "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/../lib/monet-env.sh"
cd "$MONET_HOME" || exit 1
set -uo pipefail

export PATH="/usr/local/bin:${MONET_HOME}/.local/bin:${MONET_HOME}/bin:/usr/bin:/bin"

# /var/log is not writable by the service user on a clean install.
LOG_FILE="${MONET_LOG_FILE:-${MONET_LOG_DIR:-$MONET_HOME/logs}/monet-tg.log}"
mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
{ : >> "$LOG_FILE"; } 2>/dev/null || LOG_FILE=/dev/null
LOCK_FILE="${MONET_HOME}/.monet-meeting-prep.lock"
STATE_FILE="${MONET_HOME}/.monet-meeting-prep-state"   # briefed event ids (one per line)
MODEL="${CLAUDE_MODEL:-claude-sonnet-4-6}"
JOB_TIMEOUT=240
GCAL_AUTH="${MONET_HOME}/bin/monet-gcal-auth"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] MEETINGPREP $*" >> "$LOG_FILE"; }

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

: "${BOT_TOKEN:?BOT_TOKEN not set}"
CHAT_ID="${MEETING_PREP_CHAT:-${MONET_DEFAULT_CHAT:-YOUR_CHAT_ID}}"

# Access token (silent no-op if not authorized yet)
TOKEN=$("$GCAL_AUTH" token 2>>"$LOG_FILE") || { exit 0; }
[ -z "$TOKEN" ] && exit 0

touch "$STATE_FILE"

# Fetch events starting within the next 35 minutes, emit due ones as TSV:
#   id <TAB> start_local <TAB> title <TAB> attendees <TAB> description
DUE=$(TOKEN="$TOKEN" python3 - <<'PY' 2>>"$LOG_FILE"
import os, json, urllib.parse, urllib.request, datetime
tok = os.environ["TOKEN"]
now = datetime.datetime.now(datetime.timezone.utc)
tmin = now.isoformat()
tmax = (now + datetime.timedelta(minutes=35)).isoformat()
q = urllib.parse.urlencode({
    "timeMin": tmin, "timeMax": tmax, "singleEvents": "true",
    "orderBy": "startTime", "maxResults": "10"})
url = "https://www.googleapis.com/calendar/v3/calendars/primary/events?" + q
req = urllib.request.Request(url, headers={"Authorization": "Bearer " + tok})
try:
    data = json.load(urllib.request.urlopen(req, timeout=15))
except Exception as e:
    print("", end=""); raise SystemExit(0)
for ev in data.get("items", []):
    start = ev.get("start", {})
    dt = start.get("dateTime")
    if not dt:                       # skip all-day events
        continue
    try:
        sdt = datetime.datetime.fromisoformat(dt.replace("Z", "+00:00"))
    except Exception:
        continue
    mins = (sdt - now).total_seconds() / 60.0
    if not (24 <= mins <= 35):       # only the ~30-min-before window
        continue
    eid = ev.get("id", "")
    title = (ev.get("summary") or "(untitled)").replace("\t", " ")
    att = ", ".join(a.get("email", "") for a in ev.get("attendees", [])
                    if not a.get("self")) or "none listed"
    desc = (ev.get("description") or "").replace("\t", " ").replace("\n", " ")[:300]
    local = sdt.astimezone().strftime("%-I:%M %p")
    print("\t".join([eid, local, title, att, desc]))
PY
)

[ -z "$DUE" ] && exit 0

SYS_PROMPT="You are Monet preparing ${MONET_OWNER_NAME:-the operator} for an imminent meeting — UNATTENDED, no human in the loop. Use memory_recall for past discussion and web tools for attendee/company research as needed. Output a tight prep brief as EXACTLY 3 short bullet points: (1) who/what context, (2) what matters / open decisions or history, (3) a suggested angle or question to raise. Telegram-short, no preamble, no meta-commentary."

while IFS=$'\t' read -r EID LOCAL TITLE ATT DESC; do
    [ -z "$EID" ] && continue
    grep -qxF "$EID" "$STATE_FILE" && continue      # already briefed
    log "BRIEF event=\"${TITLE:0:50}\" at=$LOCAL attendees=\"${ATT:0:60}\""

    PROMPT="${MONET_OWNER_NAME:-the operator} has a meeting at ${LOCAL} (~30 min from now): \"${TITLE}\". Attendees: ${ATT}. Notes: ${DESC:-none}. Research the attendees/company as useful and pull any relevant past discussion from memory, then give the 3-point prep brief."

    RAW=$(timeout "$JOB_TIMEOUT" claude -p --model "$MODEL" --max-turns 12 \
        --dangerously-skip-permissions --disable-slash-commands \
        --output-format json --append-system-prompt "$SYS_PROMPT" \
        "$PROMPT" 2>>"$LOG_FILE")
    RC=$?

    # Record as briefed regardless, so a transient failure won't spam on retry
    echo "$EID" >> "$STATE_FILE"

    if [ $RC -ne 0 ] || [ -z "$RAW" ]; then
        log "FAIL event=$EID rc=$RC (timeout/empty)"
        continue
    fi
    RESULT=$(printf '%s' "$RAW" | python3 -c "import sys,json;print(json.load(sys.stdin).get('result',''))" 2>/dev/null)
    [ -z "$RESULT" ] && { log "FAIL event=$EID (no result)"; continue; }

    printf '📅 *Meeting prep — %s (%s)*\n\n%s' "$TITLE" "$LOCAL" "$RESULT" \
        | "$MONET_HOME"/tg-send.sh "$CHAT_ID" 2>/dev/null
    log "DELIVERED event=$EID chat=$CHAT_ID len=${#RESULT}"
done <<< "$DUE"

# Prune state file weekly (keep last 200 briefed ids)
if [ "$(wc -l < "$STATE_FILE")" -gt 200 ]; then
    tail -100 "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
fi
