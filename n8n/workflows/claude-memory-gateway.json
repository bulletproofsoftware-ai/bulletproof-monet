          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ points: [{ id: $json.pointId, vector: $json.embedding, payload: { content: $json.content, type: $json.type, created_at: $json.created_at, tags: $json.tags } }] }) }}",
        "options": {}
      },
