# bulletproof-monet — environment configuration
#
# Copy to .env and fill in the REQUIRED values. install.sh generates every
# secret marked "generated" for you; you only need to supply the four values
# under "Required".
#
#   cp .env.example .env
#   ./install.sh --check
#
# Generate a secret by hand with:  openssl rand -hex 32
#
# NOTE ON EMPTY VALUES: this file is sourced with `set -a`, so an empty
# assignment (FOO=) exports an empty string and DEFEATS any built-in default
# rather than falling back to it. Variables whose default is computed at
# runtime are therefore shipped COMMENTED OUT. Uncomment only to override.


# === Required ===
# You must supply these four by hand. install.sh refuses to proceed without
# BOT_TOKEN and TG_AUTHORIZED_USER_ID.

# From @BotFather. See README "1. Get a Telegram bot token".
# Shaped like 123456789:AAE... Anyone holding this controls your bot.
BOT_TOKEN=

# Your numeric Telegram user/chat id — the allow-list. Monet ignores every
# other chat. See README "2. Find your chat ID".
TG_AUTHORIZED_USER_ID=

# The same id again, used by the health check, the smoke test, and scheduled
# deliveries. Set it to the same value as TG_AUTHORIZED_USER_ID.
MONET_CHAT_ID=

# The https:// origin Telegram will POST webhook updates to. This is the public
# name of your reverse proxy (see deploy/nginx/monet.conf.template), NOT a
# localhost address — Telegram must reach it from the internet.
# Required by deploy/register-webhook.sh. See README "5. Expose the webhook".
MONET_PUBLIC_URL=https://bot.example.com


# === Generated by install.sh ===
# Leave these at the placeholder text below and install.sh replaces each with
# `openssl rand -hex 32` on first run. Only edit them if you are supplying an
# existing credential (e.g. reusing a Qdrant instance).

QDRANT_API_KEY=your-qdrant-api-key
POSTGRES_PASSWORD=your-secure-password
N8N_ENCRYPTION_KEY=your-32-char-encryption-key
N8N_USER_MANAGEMENT_JWT_SECRET=your-jwt-secret
WEBHOOK_API_KEY=your-webhook-api-key
WEBHOOK_SECRET=your-webhook-ingest-secret
MONET_API_KEY=your-monet-api-key

# n8n's own REST API key. NOT generated by install.sh — n8n mints this in its
# UI (Settings -> API). Only needed if you use the n8n helper scripts.
N8N_API_KEY=


# === Identity ===

# How the assistant refers to you in its own system prompts. Neutral by
# default; set it to your name or handle for a more personal tone.
MONET_OWNER_NAME="the operator"


# === Paths ===
# All of these are derived from MONET_HOME at runtime. Leave them commented out
# unless you are relocating a directory.

# Where this checkout lives. When unset it is detected automatically from the
# location of lib/monet-env.sh, so a clean clone works with no configuration.
# The historical default is /opt/monet.
#MONET_HOME=/opt/monet

# Standard subdirectories. Each defaults to a directory under MONET_HOME.
#MONET_LOG_DIR=
#MONET_DATA_DIR=
#MONET_QUEUE_DIR=
#MONET_PENDING_DIR=

# Where Claude Code keeps its own state (~/.claude). Defaults to the invoking
# user's $HOME.
#MONET_CLAUDE_HOME=

# SQLite audit trail. Defaults to $MONET_DATA_DIR/audit.db when unset.
#MONET_AUDIT_DB=

# Scheduled-jobs file. Defaults to $MONET_DATA_DIR/scheduled-jobs.json.
#MONET_JOBS_FILE=

# Directory holding agent personas used by `bin/ask-agent`. NOT bundled — supply
# your own directory of agent markdown files, or leave unset and the tool is a
# no-op. No Telegram command depends on it.
#MONET_AGENTS_DIR=

# Directory holding skill references used by `bin/ask-ref` and bin/skill-review.
# NOT bundled — same deal as MONET_AGENTS_DIR.
#MONET_SKILLS_DIR=


# === Model & runtime ===

# Model used for bot responses. Passed straight to `claude --model`. Leave
# empty to use whatever default the Claude Code CLI is configured with; see
# https://docs.claude.com/en/docs/claude-code for currently valid model ids.
CLAUDE_MODEL=

# Path to the Claude Code binary. Defaults to `claude` on $PATH.
#MONET_CLAUDE_BIN=

# Telegram send helper used by monet-dispatch.sh. Defaults to the bundled
# scripts/tg-send.sh.
#MONET_TG_SEND=

# Seconds a foreground (inline) Telegram turn may run before it is handed off
# to the background runner.
#MONET_INLINE_TIMEOUT=

# Set to 1 to route every request through the background runner by default.
#MONET_ASYNC_DEFAULT=

# Set to 1 for a dry run of the background runner: it logs what it would do and
# executes nothing. Used by tests.
#MONET_DRYRUN=

# Set to 1 to make the queue worker process one job and exit instead of looping.
#MONET_WORKER_ONESHOT=

# How often (in turns) the session-nudge hook reminds the model of its rules.
#MONET_NUDGE_EVERY=

# Skill-harvest job (monet-skill-harvest.sh): model, lookback window, and the
# maximum number of candidates sent to the judge per run.
#HARVEST_MODEL=
#HARVEST_WINDOW_HOURS=
#HARVEST_MAX_JUDGE=

# Model used by scripts/n8n-doc.py to write workflow documentation.
#DOC_MODEL=

# Model used by monet-voice.sh to write the spoken script before TTS.
#VOICE_SCRIPT_MODEL=

# Timezone the agent-managed scheduler (monet_sched.py / monet-cron.sh) evaluates
# cron expressions in. Falls back to BRIEFING_TIMEZONE, then UTC. IANA zone name.
#MONET_TZ=

# Number of query variations monet-research.sh fans out per research request.
#RESEARCH_VARIATIONS=


# === Services ===

# Qdrant vector database. The bundled docker-compose.yml publishes it here.
QDRANT_URL=http://localhost:6334

# Ollama, used for embeddings and light local generation.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Postgres backing n8n (from the bundled compose stack).
POSTGRES_USER=n8n
POSTGRES_DB=n8n

# n8n REST API base. The bundled stack publishes n8n on 5679.
N8N_API_URL=http://localhost:5679

# Management API (dashboard + /health). Bound to 127.0.0.1.
MONET_API_PORT=8091

# Local port the Telegram webhook receiver listens on. nginx proxies to it.
# Defaults to 8093; must match the port rendered into the nginx config.
#MONET_WEBHOOK_PORT=8093

# Path the webhook is registered at. Must match the nginx location block.
WEBHOOK_PATH=/webhook/monet-tg-inbound

# TLS certificate and key paths, substituted into the rendered nginx config by
# install.sh. Point these at your certbot/letsencrypt files.
#MONET_TLS_CERT=
#MONET_TLS_KEY=

# Chat id enforced by api/monet_webhook.py as its authorization allow-list.
# Defaults to TG_AUTHORIZED_USER_ID's role; set it to the same numeric id.
# NOTE: the webhook reads THIS variable, not TG_AUTHORIZED_USER_ID.
MONET_AUTHORIZED_CHAT=

# HTML-to-Markdown proxy (docker/markdown-for-agents): upstream origin it
# fetches through, request timeout in seconds, and the max HTML body it accepts.
#ORIGIN_BACKEND=
#REQUEST_TIMEOUT=
#MAX_HTML_BYTES=


# === Optional integrations ===
# Every block below is optional. Each says what breaks when it is unset.

# Twilio — SMS/MMS delivery, consumed by send-sms.sh.
# Unset: no SMS is sent; send-sms.sh exits with "ERROR: Twilio is not configured".
# SMS_AUTHORIZED_NUMBER also receives a copy of every message sent to anyone
# else, so the operator keeps a record of what went out on their behalf.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SMS_AUTHORIZED_NUMBER=

# Text to speech, via Microsoft Edge's free online neural voices (`edge-tts`).
# No API key and no account: install the CLI with
#   pip install -r requirements-tts.txt
# TTS_ENABLED gates spoken output entirely; it ships OFF.
# TTS_VOICE is any edge-tts short name -- list them with `edge-tts --list-voices`.
# TTS_RATE is an edge-tts speed offset, e.g. -10%, +0%, +25%.
TTS_ENABLED=false
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%

# Daily briefing (monet-pulse.sh). OPT-IN and EMPTY by default: this repo bundles
# no news feeds, weather sources or intel providers, so whatever you put in
# BRIEFING_TOPICS and BRIEFING_PROMPT is the entire content of the briefing.
# With BRIEFING_ENABLED=false the cron entry fires and the script exits at once.
#
# BRIEFING_TIME       HH:MM, 24-hour. install.sh renders it into the crontab.
# BRIEFING_TIMEZONE   IANA zone name; becomes CRON_TZ for the briefing entry.
# BRIEFING_TOPICS     comma- or newline-separated topics to research each day.
#                     e.g. BRIEFING_TOPICS="postgres releases, local LLM tooling"
# BRIEFING_PROMPT     free-text instruction passed to the model verbatim.
# BRIEFING_DELIVER_TO only "telegram" is implemented; anything else is refused.
BRIEFING_ENABLED=false
BRIEFING_TIME=07:30
BRIEFING_TIMEZONE=UTC
BRIEFING_TOPICS=""
BRIEFING_PROMPT=""
BRIEFING_DELIVER_TO=telegram

# SMTP — outbound email, consumed by send-email.sh.
# Unset: email sending is unavailable; send-email.sh exits with
# "ERROR: SMTP is not configured". SMTP_USER is both the envelope sender and the
# Cc on messages addressed to anyone else. SMTP_HOST takes an optional :port —
# 465 uses implicit TLS, anything else (default 587) uses STARTTLS.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=

# Obsidian vault path, indexed for retrieval by scripts/index-obsidian.py and
# bin/reindex-obsidian.
# Unset: the Obsidian indexer is unavailable.
OBSIDIAN_VAULT=

# Telegram chat ids for unattended jobs. Each defaults to MONET_DEFAULT_CHAT,
# which itself defaults to MONET_CHAT_ID. Set individually only to split
# different job outputs into different chats.
#MONET_DEFAULT_CHAT=
#HEALTH_CHECK_CHAT_ID=
#MEETING_PREP_CHAT=
#MEMWF_CHECK_CHAT=

# Memory-governor and context-budget tuning (scripts/memory-governor.py,
# scripts/budget-watch.py). Each has a working built-in default.
#GOVERNOR_CONFIG=
#BUDGET_CONFIG=
#BUDGET_STATE=
#CONTENT_SIGNAL=

# Skill-scoring job (scripts/skill-score.py, scripts/skill-coverage-audit.py).
#SKILL_SCORES=
#SKILL_USAGE_LOG=
#SKILL_AUDIT_DAYS=

# n8n workflow-health reporting (scripts/n8n-health.py, n8n-dead.py,
# n8n-doc.py, n8n-cost.py). All have working defaults.
#N8N_DOC_DIR=
#N8N_DEAD_DAYS=
#N8N_RECENT_DAYS=
#N8N_RECOVERED_HOURS=
#N8N_EXEC_WINDOW=
#N8N_ERR_RATE_ALERT=
#N8N_DISPOSITIONS=


# === Optional CLI tools (bin/) ===
# Tuning for the standalone helpers under bin/. Every one of these has a
# working built-in default, so none is required to run Monet — the tools are
# optional and each is usable with no configuration at all. Uncomment only to
# override. The commented value shown is the literal default read from source.

# bin/backup-validate — sanity-checks the n8n workflow export directory.
# MAX_AGE_H: how many hours old the newest export may be before it is stale.
# MIN_WORKFLOWS: the fewest workflows an export must contain to count as valid.
# The backup directory itself is argv[1] (default /root/backups/n8n), NOT an
# environment variable.
#BACKUP_MAX_AGE_H=30
#BACKUP_MIN_WORKFLOWS=1

# bin/critic — scores a draft reply for quality before it is sent.
# CRITIC_MIN_CHARS: replies shorter than this are skipped, not scored.
# CRITIC_LOG defaults under $MONET_HOME, not $MONET_DATA_DIR.
#CRITIC_MODEL=claude-haiku-4-5
#CRITIC_LOG=$MONET_HOME/data/critic-scores.jsonl
#CRITIC_MIN_CHARS=200

# bin/tone-check — flags tone problems in a draft reply.
# TONE_MIN_CHARS: replies shorter than this are skipped.
#TONE_MODEL=claude-haiku-4-5
#TONE_MIN_CHARS=15

# bin/predictive-hint — suggests likely next topics from recorded patterns.
# PREDICTIVE_TZ: an IANA zone name; decides which local day/AM-PM bucket the
# current time falls into. Change this if you are not on US Eastern.
# PREDICTIVE_CONFIG defaults under $MONET_HOME, not $MONET_DATA_DIR.
#PREDICTIVE_CONFIG=$MONET_HOME/data/predictive-patterns.json
#PREDICTIVE_TZ=America/New_York

# bin/working-snapshot — extracts and ages out working-memory snapshots.
# WM_MAX_AGE_DAYS: snapshots older than this are pruned.
# MONET_WM_DIR defaults under $MONET_HOME, not $MONET_DATA_DIR.
#MONET_WM_DIR=$MONET_HOME/data/working-memory
#WM_MODEL=claude-haiku-4-5
#WM_MAX_AGE_DAYS=7

# bin/research-queue — queue file for deferred research requests.
# NOTE: this default is $MONET_HOME/research-queue.json — the repository root,
# NOT a file under data/.
#MONET_RESEARCH_QUEUE=$MONET_HOME/research-queue.json

# Log file written by monet-dispatch.sh, monet-bg-runner.sh and
# src/monet-worker-loop.sh. Defaults to monet-tg.log inside $MONET_LOG_DIR;
# set this only to redirect those three to a specific file.
#MONET_LOG_FILE=


# === Test-only ===
# Consumed only by the test suite; never read by runtime code.
# Defaults to a dummy id, so the suite runs with no configuration.
#TEST_CHAT_ID=111111111


# ---------------------------------------------------------------------------
# Maintainer note: how this list was derived, so it can be re-verified.
#
# Union of four extractions over the tracked tree:
#
#   1. Shell variables READ but never ASSIGNED (true external inputs):
#      scan every *.sh, bin/*, and src/monet-queue for ${VAR} reads, subtract
#      anything matching ^\s*(export|local|declare -x )?VAR= or `read VAR`.
#
#   2. Python:
#      git grep -hoE "os\.environ(\.get)?[\[\(][\"'][A-Z_0-9]+|os\.getenv\([\"'][A-Z_0-9]+" \
#        -- '*.py' 'bin/*' 'api/*' 'scripts/*' \
#        ':!mcp/claude-memory-mcp/node_modules' \
#        | grep -oE "[A-Z_0-9]{3,}" | sort -u
#
#      IMPORTANT: the pathspec must include 'bin/*', 'api/*' and 'scripts/*',
#      not just '*.py'. The Python helpers in bin/ (critic, tone-check,
#      backup-validate, predictive-hint, working-snapshot, research-queue,
#      monet-graph, ...) are EXTENSIONLESS executables — a '*.py'-only glob
#      silently skips every one of them. A prior revision of this file had
#      exactly that bug and under-reported the list by 12 variables.
#
#   3. TypeScript (bundled MCP server):
#      git grep -hoE 'process\.env\.[A-Z_0-9]+' -- 'mcp/claude-memory-mcp/src/*' | sort -u
#
#   4. Compose interpolation:
#      grep -ohE '\$\{[A-Z_0-9]+' docker-compose.yml docker/*/docker-compose.yml \
#        | tr -d '${' | sort -u
#
# EXCLUSION LIST — matched by the heuristics above but NOT configuration.
#
# Rule for deciding: a name is configuration only if the USER can meaningfully
# set it from outside the process. If the value is produced inside the same
# call chain immediately before it is read, it is internal plumbing — document
# it here, never as a variable above.
#
# (a) Shell/system builtins:
#   PATH HOME RANDOM SECONDS PWD IFS SHELL TMPDIR EDITOR BASH_SOURCE
#   PIPESTATUS SSL_CERT_FILE REQUESTS_CA_BUNDLE
#
# (b) Locals assigned in a different file of the same call chain, or loop/
# scratch variables the "read but not assigned" heuristic mis-flags:
#   AGE_DAYS AID ATT BODY CLAUDE_RESULT_FILE CLAUDE_SESSION_ID DAYS_UNTIL
#   DB_LAST_ACTIVITY DB_SESSION_ID DB_TURN_COUNT DUE_DT KINDS LOCAL
#   OTHER_CHANNEL RAW_JSON TGS
#
# (c) Values COMPUTED and then re-imported, never user-supplied:
#   CLAUDE_INPUT_TOKENS CLAUDE_OUTPUT_TOKENS
#   parse_claude_output() in lib/audit_helpers.sh parses Claude's JSON usage
#   block and PRINTS these as `VAR=value` lines; the caller (e.g.
#   bridges/monet-tg.sh:1694) does `eval "$(parse_claude_output "$RAW")"` on
#   the line immediately above and then reads them. Setting either in .env
#   would be overwritten on every turn and configures nothing.
#
# (d) Shell -> heredoc'd-Python handoff variables. Written as
# `VAR="$value" python3 <<'PY'` and read inside the block as
# os.environ['VAR'] with NO default (mandatory, so a missing value is a bug,
# not a fallback). The enclosing shell assigns each one a few lines earlier:
#   CHUNK_INPUT MD_INPUT (scripts/tg-send.sh)
#   NOW_TS REMIND_FILE (scripts/monet-remind.sh)
#   PAYLOAD (scripts/monet-webhook-ingest.sh)
#   N8N KEY WFS (bin/monet-memwf-check)
#   TOKEN (bin/monet-meeting-prep)
# Heuristic for spotting these: `os.environ['X']` subscript form with no
# default is almost always internal; `os.environ.get("X", default)` is almost
# always real configuration.
#
# Acceptance test — every variable the code reads must appear in this file.
# Self-contained; run from the repository root. Covers extraction (2) above,
# which is where the historical miss occurred:
#
#   comm -23 \
#     <(git grep -hoE "os\.environ(\.get)?[\[\(][\"'][A-Z_0-9]+|os\.getenv\([\"'][A-Z_0-9]+" \
#         -- '*.py' 'bin/*' 'api/*' 'scripts/*' \
#         ':!mcp/claude-memory-mcp/node_modules' \
#       | grep -oE "[A-Z_0-9]{3,}" | sort -u) \
#     <(grep -oE '^#?[A-Z][A-Z0-9_]*' .env.example | tr -d '#' | sort -u)
#
# Expected output: ONLY names already on the exclusion list above. Any name
# that is neither documented nor excluded is a genuine gap — document it, or
# add it to the exclusion list WITH the reason it is not configuration.
# ---------------------------------------------------------------------------
