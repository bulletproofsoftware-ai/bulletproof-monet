# bulletproof-monet — reverse proxy.
#
# install.sh renders this to build/nginx/monet.conf and prints the install command.
# It does NOT install it: nginx layout varies too much across distros to automate
# safely (conf.d vs sites-available, different user, different reload command).
#
# Render manually:
#   sed -e 's|@MONET_SERVER_NAME@|bot.example.com|' \
#       -e 's|@MONET_TLS_CERT@|/etc/letsencrypt/live/bot.example.com/fullchain.pem|' \
#       -e 's|@MONET_TLS_KEY@|/etc/letsencrypt/live/bot.example.com/privkey.pem|' \
#       -e 's|@MONET_WEBHOOK_PORT@|8093|' \
#       deploy/nginx/monet.conf.template > /etc/nginx/conf.d/monet.conf
#
# Telegram requires a publicly reachable HTTPS endpoint with a valid certificate
# (or a self-signed cert uploaded via setWebhook's certificate parameter), on
# port 443, 80, 88 or 8443.

server {
    listen 443 ssl;
    http2 on;
    server_name @MONET_SERVER_NAME@;

    ssl_certificate     @MONET_TLS_CERT@;
    ssl_certificate_key @MONET_TLS_KEY@;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Telegram's published webhook source ranges.
    # Verified against https://core.telegram.org/bots/webhooks on 2026-07-24:
    #   "Accepts incoming POSTs from subnets 149.154.160.0/20 and 91.108.4.0/22"
    # Telegram warns this range may change — if webhooks start failing with no
    # traffic reaching the app, re-check that page before debugging anything else.
    # Note: Telegram does not support IPv6 for webhooks.
    allow 149.154.160.0/20;
    allow 91.108.4.0/22;
    deny  all;

    client_max_body_size 20m;

    location /webhook/monet-tg-inbound {
        proxy_pass http://127.0.0.1:@MONET_WEBHOOK_PORT@;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Everything else: drop the connection without a response.
    location / { return 444; }
}

server {
    listen 80;
    server_name @MONET_SERVER_NAME@;
    return 301 https://$host$request_uri;
}
